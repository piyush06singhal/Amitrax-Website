# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxx

# Where inquiry emails are delivered. Must be the Resend account owner's
# email when sending from onboarding@resend.dev (unverified sender).
CONTACT_TO=you@example.com

# Sender address. Must use a domain verified on your Resend account.
# onboarding@resend.dev works for testing without a verified domain.
RESEND_FROM=AmitraX Website <onboarding@resend.dev>